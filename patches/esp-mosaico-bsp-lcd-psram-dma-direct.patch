+    config BSP_LCD_PSRAM_DMA_DIRECT
+        bool "Send PSRAM frame data to the LCD without internal bounce buffers"
+        depends on BSP_DISPLAY_ENABLE
+        default n
+        help
+            When disabled, every LCD chunk read from PSRAM is first copied into an
+            internal DMA buffer: up to 10 x 7.5 KB of internal RAM while a frame is
+            in flight. Enable for applications that run Wi-Fi next to the display;
+            the SPI DMA then reads PSRAM directly, which is slower but needs no
+            internal RAM.
