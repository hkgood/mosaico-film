CONFIG_IDF_TARGET="esp32s31"
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Persist ESP-IDF Core Dumps and the bounded ESP-Iris pre-crash log ring in
# the retained coredump partition after a panic.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_APP_RETRIEVE_LEN_ELF_SHA=64
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_FACTORY_RECOVERY_BOOT_GPIO=7
CONFIG_FACTORY_RECOVERY_BOOT_DEBOUNCE_MS=50

# USB High-Speed is owned by ESP-Iris. Device installation and logs go through
# the repository's mosaico.py commands. Keep the console on UART and avoid the
# built-in USB Serial/JTAG controller.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_IRIS_TRANSPORT_USB=y
CONFIG_ESP_IRIS_TRANSPORT_TCP=y
CONFIG_ESP_IRIS_NVS_PARTITION_NAME="sysmeta"
CONFIG_ESP_IRIS_TRANSPORT_CLAIM_TIMEOUT_MS=2000
CONFIG_ESP_IRIS_TCP_PORT=19772
CONFIG_ESP_IRIS_TCP_PAIRING=y
CONFIG_ESP_IRIS_TCP_DEFER_UNTIL_NETIF=y
CONFIG_ESP_IRIS_TASK_STACK_SIZE=3328
CONFIG_ESP_IRIS_USB_TASK_STACK_SIZE=2048
CONFIG_ESP_IRIS_SERVICE_STACK_SIZE=4096
CONFIG_ESP_IRIS_SERVICE_PERSISTENT=y
CONFIG_ESP_IRIS_SERVICE_CONTEXT_PSRAM=y
CONFIG_ESP_IRIS_SERVICE_STATE_PSRAM=y
CONFIG_ESP_IRIS_RPC_RESPONSE_PSRAM=y
CONFIG_ESP_IRIS_WIRE_BUFFERS_PSRAM=y
CONFIG_ESP_IRIS_LOG_RING_BYTES=4096
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_ESP_IRIS_LOG_RING_STORAGE_PSRAM=y
# Mirror chunks are copied into ESP-Iris's wire frame before USB DMA.
CONFIG_ESP_IRIS_MEDIA_BUFFER_PSRAM=y
# ESP-Iris assembles a wire frame in its own 4096-byte buffer. CDC can feed
# and drain it in chunks; keep RX >= endpoint capacity.
CONFIG_TINYUSB_CDC_RX_BUFSIZE=1024
CONFIG_TINYUSB_CDC_TX_BUFSIZE=1024
CONFIG_TINYUSB_CDC_EP_BUFSIZE=512

# ESP-Mosaico 480x480 CO5300 QSPI display. GSP presents through
# esp_display_present; the BSP still pulls LVGL as a dependency.
CONFIG_BSP_CO5300_ENABLE_TE=y
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y

# OV3640 in the left slot: UYVY 640x480@30 feeds the viewfinder, the
# sensor's full-resolution 2048x1536 JPEG is used for stills.
CONFIG_MOSAICO_MODULE_CAMERA=y
CONFIG_CAMERA_OV3640_DVP_YUV422_UYVY_640X480_30FPS=y
CONFIG_CAMERA_OV3640_DVP_JPEG_2048X1536_15FPS=y
CONFIG_CAMERA_OV3640_DVP_DEFAULT_FMT_YUV422_UYVY_640X480_30FPS=y

# Photos: onboard NAND LittleFS shared with Vibe Mode. The on-disk limits must
# match Vibe Mode's or the volume will not mount.
CONFIG_NAND_FLASH_ENABLE_BDL=y
CONFIG_LITTLEFS_OBJ_NAME_LEN=255
CONFIG_LITTLEFS_CACHE_SIZE=4096
CONFIG_LITTLEFS_MALLOC_STRATEGY_SPIRAM=y
# Runtime-only (not stored on disk). The FTL volume uses 2 KB LittleFS blocks; a
# 128-byte lookahead only covers 2 MB, so LittleFS re-walked every file on the
# volume every few hundred KB of writes (10+ s per photo). 8 KB covers 65536
# blocks, i.e. the whole 128 MB NAND, so a walk happens about once per boot.
CONFIG_LITTLEFS_LOOKAHEAD_SIZE=8192

# Send-to-phone: router (STA) or the camera's own hotspot (SoftAP) + web page.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# The AXI GDMA has three channel pairs, needed by the LCD SPI, the NAND SPI and
# the camera DVP. Hardware SHA/AES would claim a fourth pair on first use and
# never release it, starving the camera. The app does no TLS, so mbedtls runs
# SHA/AES in software.
# CONFIG_MBEDTLS_HARDWARE_SHA is not set
# CONFIG_MBEDTLS_HARDWARE_AES is not set
# GPIO33 is camera D2 and shares the USB Serial/JTAG D- pad.
# CONFIG_USJ_ENABLE_USB_SERIAL_JTAG is not set
# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG is not set

CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_MEMTEST=n

CONFIG_ESP_MAIN_TASK_STACK_SIZE=20480
# film_power 用空闲任务运行时间统计各核 CPU 占用
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_ESP_TASK_WDT_INIT=n

CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="1.0.0"
